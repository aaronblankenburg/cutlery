# Cutlery settings. Copy to .env and adjust:  cp .env.example .env
# Then set the password:  docker compose run --rm --no-deps cutlery set-password
# And start:              docker compose up -d

# --- Storage (host paths; create them first, owned by PUID:PGID) -------------------------------------------
# Must be kept and backed up:
CUTLERY_DATA_DIR=./data
# Can be regenerated (360p copies, analysis, renders, exports); exclude it from backups:
CUTLERY_WORK_DIR=./work
# Downloaded models, shared by all projects:
CUTLERY_MODELS_DIR=./models
# The Claude token you enter in the web UI (Settings) is stored here (mode 700). Only the runner service mounts it:
CUTLERY_SECRETS_DIR=./secrets

# Containers write files as this user and group (your user: `id -u` and `id -g`).
PUID=1000
PGID=1000

# --- Network ------------------------------------------------------------------------------------------------
# Cutlery listens only on this machine by default; a reverse proxy with HTTPS makes it reachable (see examples/).
CUTLERY_BIND=127.0.0.1
CUTLERY_PORT=8080
# Proxies whose X-Real-IP / X-Forwarded-For header is trusted for the login lockout:
#CUTLERY_TRUSTED_PROXIES=127.0.0.0/8,::1/128,172.16.0.0/12

# Warn in the UI when a storage tree has less free space than this (GB):
#CUTLERY_DISK_WARN_GB=20

# Analysis starts while clips are still arriving: it waits this many seconds after the last finished upload, then
# runs once for everything that has arrived. Projects analysed at the same time (each needs several CPU cores):
#CUTLERY_ANALYSIS_SETTLE_SECONDS=20
#CUTLERY_ANALYSIS_PARALLEL=1
# Extra arguments for `cutter analyze` (see `cutter analyze --help`), for example a smaller speech model:
#CUTLERY_ANALYSIS_ARGS=--model small
#TZ=Europe/Berlin

# --- Claude --------------------------------------------------------------------------------------------------
# Easiest: enter your subscription token in the web UI under Settings. Or set exactly one of the two below, each a
# file with mode 600 (only the runner service reads it); a setting here takes precedence over the web UI.
# Your own Claude subscription, for your personal use only (token from `claude setup-token`, valid for a year):
#CLAUDE_CODE_OAUTH_TOKEN_FILE=/path/to/secrets/claude-oauth-token
# Or an API key from the Claude Console; required if you offer Cutlery to other people:
#ANTHROPIC_API_KEY_FILE=/path/to/secrets/anthropic-api-key
# With a subscription token: its expiry date, for a warning in the UI 30 days before (YYYY-MM-DD):
#CUTLERY_CLAUDE_TOKEN_EXPIRES=2027-11-12

# Models: the first draft and the following cuts (a cut with little feedback works well with Sonnet):
#CUTLERY_MODEL_DRAFT=claude-opus-5-5
#CUTLERY_MODEL_NEXT=claude-sonnet-5-5
# Jobs at the same time (each is one Claude Code session plus rendering), turns per session, hours per job:
#CUTLERY_JOBS_PARALLEL=1
#CUTLERY_MAX_TURNS=400
#CUTLERY_JOB_TIMEOUT_HOURS=8
#CUTLERY_JOB_MEMORY_GB=8

# Hosts a job may reach (HTTPS only, through the runner's proxy). The default: api.anthropic.com, the music sources
# Free Music Archive, ccMixter, Wikimedia Commons, Internet Archive and Jamendo, map outlines (jsDelivr, unpkg,
# Natural Earth) and Hugging Face for the analysis models. Replace the whole list to change it:
#CUTLERY_EGRESS_ALLOW=api.anthropic.com,freemusicarchive.org,*.freemusicarchive.org

# --- Notifications when a job ends or pauses (optional) -------------------------------------------------------
# The address of this Cutlery for links in messages:
#CUTLERY_PUBLIC_URL=https://cutlery.example.org
# A webhook that receives a JSON POST:
#CUTLERY_WEBHOOK_URL=https://hooks.example.org/cutlery
# MQTT (user and password are optional):
#CUTLERY_MQTT_HOST=mqtt.example.org
#CUTLERY_MQTT_PORT=1883
#CUTLERY_MQTT_TOPIC=cutlery/jobs
#CUTLERY_MQTT_USER=
#CUTLERY_MQTT_PASSWORD=
